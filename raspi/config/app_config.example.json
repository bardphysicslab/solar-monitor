{
  "app_id": "solar-monitor",
  "mode": "sensor_monitor",
  "poll_interval_ms": 1500,
  "title": "Solar Monitor",
  "data_api": {
    "token": ""
  },
  "backup": {
    "enabled": true,
    "interval_minutes": 30,
    "remote": "REPLACE_WITH_EXISTING_RCLONE_REMOTE",
    "destination": "solar-monitor"
  },
  "drivers": [
    {
      "driver": "wifi_node",
      "uid": "bb-solar-pnl-001",
      "config": {
        "host": "REPLACE_WITH_ESP32_IP",
        "port": 1234,
        "timeout_s": 3,
        "panel_spec": {
          "voc_v": 8.51,
          "vmp_v": 7.28,
          "imp_a": 0.33,
          "isc_a": null,
          "pmp_w": 2.37,
          "power_tolerance_pct": 10
        },
        "limits": {
          "absolute": {
            "max_voltage_v": "REPLACE_WITH_PANEL_MANUFACTURER_RATING",
            "max_current_a": "REPLACE_WITH_PANEL_MANUFACTURER_RATING",
            "max_power_w": "REPLACE_WITH_PANEL_MANUFACTURER_RATING"
          },
          "operating": {
            "max_voltage_v": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT",
            "max_current_a": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT",
            "max_power_w": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT"
          }
        },
        "recording": {
          "enabled": true,
          "interval_s": 10,
          "mode": "mean"
        }
      }
    },
    {
      "driver": "spn1",
      "uid": "spn1-0001",
      "config": {
        "port": "/dev/cu.PL2303G-USBtoUART1130",
        "baud": 9600,
        "auto_sync_time": true,
        "sync_interval_hours": 24,
        "recording": {
          "enabled": true,
          "interval_s": 10,
          "mode": "mean"
        }
      }
    },
    {
      "driver": "et54",
      "uid": "yertai-et5406a-plus-001",
      "config": {
        "panel_uid": "bb-solar-pnl-001",
        "load_type": "electronic_load",
        "port": "/dev/serial/by-id/REPLACE_ME",
        "baud": 9600,
        "mode": "CR",
        "resistance_ohm": 800,
        "default_selected_mode": "fixed_resistance",
        "limits": {
          "absolute": {
            "max_voltage_v": 120,
            "max_current_a": 20,
            "max_power_w": 200,
            "min_load_resistance_ohm": 0.05,
            "max_load_resistance_ohm": 4500
          },
          "operating": {
            "max_voltage_v": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT",
            "max_current_a": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT",
            "max_power_w": "REPLACE_WITH_CONSERVATIVE_WORKING_LIMIT",
            "max_load_resistance_ohm": 4500
          }
        },
        "cr": {
          "max_load_resistance_ohm": 4500
        },
        "sweep": {
          "interval_s": 10,
          "settle_s": 0.5,
          "max_load_resistance_ohm": 4500,
          "point_count": 12
        },
        "irradiance_quality": {
          "max_std_w_m2": "REPLACE_WITH_STUDY_THRESHOLD",
          "max_relative_range": "REPLACE_WITH_STUDY_THRESHOLD"
        },
        "recording": {
          "enabled": true,
          "interval_s": 10,
          "mode": "mean"
        }
      }
    }
  ]
}
